{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(.venv/Scripts/python.exe scripts/status.py)",
      "Bash(.venv/Scripts/python.exe scripts/run_tests.py:*)"
    ],
    "deny": [
      "Bash(shutdown:*)",
      "Bash(rm -rf data/*)",
      "Bash(Remove-Item*data*)",
      "Read(./.env)"
    ]
  }
}
