# Clave de Riot — https://developer.riotgames.com/ (las de desarrollo caducan cada 24h).
# Compartida con ../build_tracker (mismo owner), pero cada proyecto lee su propio .env.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Lockfile del cliente de League (para descargar/abrir replays vía LCU).
# Por defecto: C:\Riot Games\League of Legends\lockfile
#LCU_LOCKFILE=C:\Riot Games\League of Legends\lockfile
